# Adapted from moby/profiles at 4b8214fc4971e06172938a1f1554ccff6647ee80.
abi <abi/3.0>,
#include <tunables/global>

profile jobslahfinder-parser flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network unix,
  capability,
  file,
  umount,

  # Bubblewrap creates these mounts only after entering its own user/mount
  # namespaces. The container still has no capabilities in its parent namespace.
  mount fstype=(tmpfs,proc,devpts),
  mount options=(rw,bind),
  mount options=(rw,rbind),
  mount options=(rw,bind,silent),
  mount options=(rw,rbind,silent),
  remount options in (rw,ro,bind,rbind,remount,nosuid,nodev,noexec,noatime,nodiratime,relatime,silent) /**,
  mount options in (rw,rslave,silent) -> /,
  mount options in (rw,rprivate,silent) -> /oldroot/,
  pivot_root,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=jobslahfinder-parser,
  ptrace (trace,tracedby,read,readby) peer=jobslahfinder-parser,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
