APP_ENV=development
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_DB=jobapp
POSTGRES_USER=jobapp
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql+psycopg://jobapp:replace-with-a-random-local-password@postgres:5432/jobapp

REDIS_URL=redis://redis:6379/0

SESSION_SECRET=replace-with-at-least-32-random-characters
PASSWORD_RESET_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=job_platform_session
SESSION_EXPIRE_MINUTES=480
PASSWORD_RESET_EXPIRE_MINUTES=30

UPLOAD_DIR=/var/lib/jobapp/uploads
MAX_UPLOAD_BYTES=5242880
ALLOWED_JOB_SOURCE_DOMAINS=sg.jobstreet.com,www.mycareersfuture.gov.sg
SCRAPING_REQUEST_TIMEOUT_SECONDS=15
SCRAPING_MAX_RETRIES=2

NEXT_PUBLIC_API_BASE_URL=/api
