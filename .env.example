APP_ENV=production
DEBUG=false

POSTGRES_DB=jobapp
POSTGRES_USER=jobapp
POSTGRES_PASSWORD=replace_with_a_strong_database_password

DATABASE_URL=postgresql+psycopg://jobapp:replace_with_a_strong_database_password@postgres:5432/jobapp
REDIS_URL=redis://redis:6379/0

SESSION_SECRET=replace_with_at_least_32_random_characters
PASSWORD_RESET_SECRET=replace_with_at_least_32_random_characters
SESSION_COOKIE_NAME=job_platform_session
SESSION_EXPIRE_MINUTES=480
PASSWORD_RESET_EXPIRE_MINUTES=30

UPLOAD_DIR=/var/lib/jobapp/uploads
MAX_UPLOAD_BYTES=5242880
ALLOWED_JOB_SOURCE_DOMAINS=sg.jobstreet.com,www.mycareersfuture.gov.sg

NEXT_PUBLIC_API_BASE_URL=/api
