APP_ENV=production
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_DB=jobapp
POSTGRES_USER=jobapp
POSTGRES_PASSWORD=change-me
# Use the same password as POSTGRES_PASSWORD (URL-encode special characters).
DATABASE_URL=postgresql+psycopg://jobapp:change-me@postgres:5432/jobapp

REDIS_URL=redis://redis:6379/0

SESSION_SECRET=change-me-generate-with-openssl-rand-base64-48
PASSWORD_RESET_SECRET=change-me-generate-with-openssl-rand-base64-48
SESSION_COOKIE_NAME=job_platform_session
SESSION_EXPIRE_MINUTES=480
PASSWORD_RESET_EXPIRE_MINUTES=30
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_CIDRS=172.16.0.0/12

UPLOAD_DIR=/var/lib/jobapp/uploads
MAX_UPLOAD_BYTES=5242880
RESUME_PARSER_TIMEOUT_SECONDS=60
RESUME_PARSER_MAX_TEXT_CHARS=8000

ALLOWED_JOB_SOURCE_DOMAINS=sg.jobstreet.com,www.mycareersfuture.gov.sg,www.jobslah.com,www.fastjobs.sg
SCRAPING_REQUEST_TIMEOUT_SECONDS=120
SCRAPING_MAX_RETRIES=0

NEXT_PUBLIC_API_BASE_URL=/api

RESUME_EXTRACTION_PROVIDER=gemini

# Optional: only used by infra/scripts/download-geolite.sh (never commit a real key).
# MAXMIND_LICENSE_KEY=

# Used for verified resume extraction and AI features such as cover letters and interview questions.
GEMINI_RESUME_MODEL=gemini-2.5-flash-lite
GEMINI_RESUME_MAX_OUTPUT_TOKENS=8192
GEMINI_API_KEY=change-me

# Public HTTPS origin of the site. Production refuses to start unless this is https and not localhost.
FRONTEND_BASE_URL=https://jobs.your-domain.example

# Production compose profile (docker-compose.prod.yml)
DOMAIN=jobs.your-domain.example
LETSENCRYPT_EMAIL=admin@your-domain.example
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Use a transactional provider (e.g. Amazon SES) with SPF/DKIM configured for your domain.
SMTP_HOST=smtp.example-provider.com
SMTP_PORT=587
SMTP_USERNAME=change-me@example.com
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=change-me@example.com
SMTP_USE_TLS=true
