# Copy this file to .env and replace every placeholder before running services.
# Do not commit real secrets.

APP_ENV=development
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_DB=replace_with_local_database_name
POSTGRES_USER=replace_with_local_database_user
POSTGRES_PASSWORD=replace_with_local_database_password
DATABASE_URL=postgresql+psycopg://replace_with_local_database_user:replace_with_local_database_password@postgres:5432/replace_with_local_database_name

REDIS_URL=redis://redis:6379/0

SESSION_SECRET=replace_with_random_32_plus_character_secret
PASSWORD_RESET_SECRET=replace_with_random_32_plus_character_secret

UPLOAD_DIR=/var/lib/jobapp/uploads
MAX_UPLOAD_BYTES=5242880

ALLOWED_JOB_SOURCE_DOMAINS=sg.jobstreet.com,www.mycareersfuture.gov.sg

FRONTEND_INTERNAL_URL=http://frontend:3000
BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=/api
