APP_ENV=development
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000

POSTGRES_DB=jobapp
POSTGRES_USER=jobapp
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql+psycopg://jobapp:replace-with-a-random-local-password@postgres:5432/jobapp

REDIS_URL=redis://redis:6379/0

SESSION_SECRET=replace-with-at-least-32-random-characters
PASSWORD_RESET_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=job_platform_session
SESSION_EXPIRE_MINUTES=480
ADMIN_SESSION_MAX_AGE_MINUTES=120
PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_BASE_URL=http://localhost:3000
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=replace-with-smtp-username
# SMTP_PASSWORD=replace-with-smtp-password
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_USE_TLS=true

UPLOAD_DIR=/var/lib/jobapp/uploads
MAX_UPLOAD_BYTES=5242880
RESUME_PARSER_TIMEOUT_SECONDS=10
RESUME_PARSER_MAX_TEXT_CHARS=20000
RESUME_EXTRACTION_PROVIDER=local
GEMINI_RESUME_MODEL=gemini-2.5-flash-lite
GEMINI_RESUME_MAX_OUTPUT_TOKENS=2048
COVER_LETTER_GENERATION_PROVIDER=local
GEMINI_COVER_LETTER_MODEL=gemini-2.5-flash-lite
GEMINI_COVER_LETTER_MAX_OUTPUT_TOKENS=2048
# GEMINI_API_KEY=replace-with-provider-key-when-using-gemini

ALLOWED_JOB_SOURCE_DOMAINS=sg.jobstreet.com,www.mycareersfuture.gov.sg,www.jobslah.com,www.fastjobs.sg
SCRAPING_REQUEST_TIMEOUT_SECONDS=15
SCRAPING_MAX_RETRIES=2

NEXT_PUBLIC_API_BASE_URL=/api

# Optional risk engine configuration.
RISK_ENGINE_DATA_DIR=/var/lib/jobapp/risk-engine
RISK_ENGINE_BASE_PATH=/risk-engine
RISK_ENGINE_ENFORCE_API_KEY=1
RISK_ENGINE_HTTPS_ONLY=false
RISK_ENGINE_ADMIN_SESSION_TIMEOUT_SEC=900
TRUSTED_PROXY_CIDRS=172.16.0.0/12
